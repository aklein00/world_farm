{
  "name": "worldfarm-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "node scripts/check.mjs",
    "package:site": "node scripts/package.mjs",
    "preview:worker": "wrangler dev --ip 127.0.0.1",
    "deploy:check": "npm run build && wrangler deploy --dry-run",
    "deploy": "npm run check && npm test && npm run build && wrangler deploy",
    "build:vercel": "node scripts/build-vercel.mjs"
  },
  "devDependencies": {
    "wrangler": "4.158.0"
  }
}
